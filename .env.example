# Safe local defaults. Do not place secrets in this file.
PROJECT_INVEST_ENVIRONMENT=development
PROJECT_INVEST_BASE_CURRENCY=INR
PROJECT_INVEST_EXECUTION_MODE=paper
PROJECT_INVEST_MARKET_DATA_PROVIDER=yahoo
PROJECT_INVEST_ALLOW_MOCK_DATA=false
PROJECT_INVEST_ALLOW_MOCK_FALLBACK=false
# Required to invoke POST /api/research/run or POST /api/trading/run.
# Generate a strong random value locally; never commit it.
PROJECT_INVEST_API_AUTH_TOKEN=
PROJECT_INVEST_STORAGE_BACKEND=local
PROJECT_INVEST_STORAGE_CACHE_ENABLED=false
PROJECT_INVEST_USE_MARKET_UNIVERSES=true
PROJECT_INVEST_MARKET_UNIVERSES=NSE
PROJECT_INVEST_EXECUTION_MARKETS=NSE
PROJECT_INVEST_RESEARCH_INTERVAL=1d
PROJECT_INVEST_TRADING_INTERVAL=5m
PROJECT_INVEST_RESEARCH_LOOP_ENABLED=false
PROJECT_INVEST_TRADING_LOOP_ENABLED=false
PROJECT_INVEST_LIVE_LOOP_ENABLED=false
# LOCAL-LITE is the default local job profile: one research job at a time.
# CPU and memory values are monitoring thresholds, not process-kill limits.
PROJECT_INVEST_RUNTIME_MONITOR_ENABLED=true
PROJECT_INVEST_RUNTIME_MONITOR_INTERVAL_SECONDS=5
PROJECT_INVEST_JOB_EXECUTOR_ENABLED=true
PROJECT_INVEST_LOCAL_LITE_CONCURRENCY=1
PROJECT_INVEST_LOCAL_LITE_JOB_TIMEOUT_SECONDS=1800
